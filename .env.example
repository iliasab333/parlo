# ---------------------------------------------------------------
# apps/signal
# ---------------------------------------------------------------
PORT=8787

# Durable moderation state (bans, reports). Any Postgres 14+ works:
# Supabase, Neon, or local. WITHOUT this the server falls back to an
# in-memory store and every ban dies with the process — development
# only, and it says so loudly at boot.
# Apply db/migrations/001_moderation.sql before first start.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Parlo's tables live here, not in `public`: databases get shared and
# `reports` is a name plenty of other apps already use.
DB_SCHEMA=parlo

# When the ban lookup itself fails, deny by default. An outage that
# lets every banned device back in is the worse failure mode. Flip
# only as a deliberate availability call.
BAN_CHECK_FAIL_OPEN=false

# Comma-separated browser origins. "*" is DEVELOPMENT ONLY.
ALLOWED_ORIGINS=http://localhost:3000

# MUST be "true" in production. See LEGAL.md §2 — a self-declared
# checkbox is not age assurance and will not satisfy the UK OSA,
# the US state AV statutes, or an App Store reviewer.
REQUIRE_AGE_TOKEN=false

# Signs device tokens. Change it; rotating it invalidates every ban.
DEVICE_TOKEN_SECRET=change-me

# Matchmaking. Language/region constraints relax after this long in
# the queue; gender preferences never do.
MATCH_TICK_MS=250
RELAX_AFTER_MS=20000
REMATCH_COOLDOWN_MS=900000

# Moderation thresholds.
# Threshold counts DISTINCT accusers, not reports: otherwise one
# person could ban anyone by reporting them repeatedly.
STRIKE_THRESHOLD=3
STRIKE_WINDOW_MS=86400000
BAN_MS=86400000

# Report rate limit, enforced against the database so it survives
# reconnects. Minor-safety reports are exempt.
RL_REPORTS=20
RL_REPORT_WINDOW_MS=3600000

# TURN is NOT optional in production: ~10-20% of users sit behind
# symmetric NAT and see a black screen without it. Budget for the
# relayed bandwidth. See README → "TURN no es opcional".
# TURN_URL=turn:turn.example.com:3478
# TURN_USERNAME=
# TURN_CREDENTIAL=

# ---------------------------------------------------------------
# apps/web
# ---------------------------------------------------------------
NEXT_PUBLIC_SIGNAL_URL=ws://localhost:8787
